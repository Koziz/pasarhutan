	bad    = Color3.fromRGB(226, 90, 90),
}

local function make(class, parent, props)
	local o = Instance.new(class)
	o.Name = props.Name or class
	for k, v in pairs(props) do
		if k ~= "Name" and k ~= "Parent" then
			pcall(function() o[k] = v end)
		end
	end
	if parent then
		o.Parent = parent
	end
	return o
end

local function corner(o, r)
	make("UICorner", o, { CornerRadius = UDim.new(0, r or 8) })
end

local function label(parent, text, size, pos, size2, color)
	return make("TextLabel", parent, {
		BackgroundTransparency = 1,
		Text = text,
		TextSize = size or 13,
		TextColor3 = color or COL.text,
		Font = Enum.Font.GothamMedium,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = pos,
		Size = size2,
	})
end

