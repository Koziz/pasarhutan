local function getRakAksiRemote()
	if cachedRemote then return cachedRemote end
	for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
		if obj:IsA("RemoteFunction") and obj.Name == "RakAksi" then cachedRemote = obj return obj end
	end
	return nil
end

local function getMyKios()
	local folder = Workspace:FindFirstChild("KiosAktif") or Workspace:FindFirstChild("Kios")
	if not folder then return nil end
	for _, m in ipairs(folder:GetChildren()) do
		if m:IsA("Model") and m:GetAttribute("OwnerUserId") == LocalPlayer.UserId then return m end
	end
	return nil
end

local function getKiosSlots()
	local kios = getMyKios()
	if not kios then return {} end
	local slots = {}
	for _, att in ipairs(kios:GetDescendants()) do
		if att:IsA("Attachment") and att.Name:match("^slot%d+$") then table.insert(slots, att) end
	end
	table.sort(slots, function(a, b) return (tonumber(a.Name:match("%d+$")) or 0) < (tonumber(b.Name:match("%d+$")) or 0) end)
	return slots
end

local function getBackpackItems()
	local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
	local items, seen = {}, {}
	if bp then
		for _, t in ipairs(bp:GetChildren()) do
			if t:IsA("Tool") then
				local id = t:GetAttribute("ItemId") or t.Name
				if type(id) == "string" and id ~= "" and not seen[id] then seen[id] = true table.insert(items, id) end
			end
		end
	end
	return items
end

local function getAvailableLootItems()
	local items = {"Semua"}
	local seen = {}
	local spawnBahan = Workspace:FindFirstChild("SpawnBahan")
	if spawnBahan then
		for _, obj in ipairs(spawnBahan:GetChildren()) do
			local name = obj.Name
			if not seen[name] and name ~= "Part" and name ~= "Model" then
				seen[name] = true
				table.insert(items, name)
			end
		end
	end
	return items
end

-- FUNGSI BARU: Cek apakah ada bagian dari barang yang terlihat (bukan sekadar hitbox transparan)
local function isItemVisible(itemModel)
	if itemModel:IsA("BasePart") and itemModel.Transparency < 1 then return true end
	for _, child in ipairs(itemModel:GetDescendants()) do
		if child:IsA("BasePart") and child.Transparency < 1 then
			return true
		end
	end
	return false
end

