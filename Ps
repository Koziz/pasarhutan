	frame.Parent = parent

	local lbl = Instance.new("TextLabel")
	lbl.Size, lbl.BackgroundTransparency = UDim2.new(1, 0, 0, 14), 1
	lbl.Text, lbl.TextColor3, lbl.Font, lbl.TextSize = "  " .. titleText, Color3.fromRGB(186, 194, 222), Enum.Font.GothamMedium, 10
	lbl.TextXAlignment, lbl.Parent = Enum.TextXAlignment.Left, frame

	local btn = Instance.new("TextButton")
	btn.Size, btn.Position = UDim2.new(1, 0, 0, 26), UDim2.new(0, 0, 0, 18)
	btn.BackgroundColor3, btn.Text = Color3.fromRGB(30, 30, 46), "   " .. initialVal .. "  ▼"
	btn.TextColor3, btn.Font, btn.TextSize = Color3.fromRGB(205, 214, 244), Enum.Font.Gotham, 11
	btn.TextXAlignment, btn.ZIndex = Enum.TextXAlignment.Left, 10
	btn.Parent = frame
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

	local scrollList = Instance.new("ScrollingFrame")
	scrollList.Size, scrollList.Position = UDim2.new(1, 0, 0, 0), UDim2.new(0, 0, 1, 2)
	scrollList.BackgroundColor3, scrollList.Visible, scrollList.ZIndex = Color3.fromRGB(24, 24, 37), false, 20
	scrollList.ScrollBarThickness = 2
	scrollList.Parent = btn
	Instance.new("UICorner", scrollList).CornerRadius = UDim.new(0, 6)
	Instance.new("UIListLayout", scrollList)

	btn.Activated:Connect(function()
		scrollList.Visible = not scrollList.Visible
		if scrollList.Visible then
			for _, c in ipairs(scrollList:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
			
			local opts = type(getOptionsFunc) == "function" and getOptionsFunc() or getOptionsFunc
			if #opts == 0 then opts = {"Menunggu data..."} end
			
			for _, opt in ipairs(opts) do
				local optBtn = Instance.new("TextButton")
				optBtn.Size, optBtn.BackgroundColor3 = UDim2.new(1, 0, 0, 26), Color3.fromRGB(24, 24, 37)
				optBtn.Text, optBtn.TextColor3 = "   " .. opt, Color3.fromRGB(205, 214, 244)
				optBtn.Font, optBtn.TextSize, optBtn.TextXAlignment = Enum.Font.Gotham, 11, Enum.TextXAlignment.Left
				optBtn.ZIndex = 21
				optBtn.Parent = scrollList
				optBtn.Activated:Connect(function()
					btn.Text = "   " .. opt .. "  ▼"
					scrollList.Visible = false
					frame.Size = UDim2.new(1, 0, 0, 45)
					onSelect(opt)
				end)
			end
			
			local listHeight = math.min(#opts * 26, 100)
			scrollList.Size = UDim2.new(1, 0, 0, listHeight)
			scrollList.CanvasSize = UDim2.new(0, 0, 0, #opts * 26)
			frame.Size = UDim2.new(1, 0, 0, 45 + listHeight) 
		else
			frame.Size = UDim2.new(1, 0, 0, 45)
		end
	end)
end

local function createToggle(parent, text, onToggle)
	local active = false
	local btn = Instance.new("TextButton")
	btn.Size, btn.BackgroundColor3 = UDim2.new(1, 0, 0, 30), Color3.fromRGB(30, 30, 46)
	btn.Text, btn.TextColor3, btn.Font, btn.TextSize = "  " .. text, Color3.fromRGB(205, 214, 244), Enum.Font.GothamBold, 11
	btn.TextXAlignment, btn.ZIndex = Enum.TextXAlignment.Left, 1
	btn.Parent = parent
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
	
	local ind = Instance.new("Frame")
	ind.Size, ind.Position = UDim2.new(0, 10, 0, 10), UDim2.new(1, -20, 0.5, -5)
	ind.BackgroundColor3 = Color3.fromRGB(243, 139, 168)
	ind.Parent = btn
	Instance.new("UICorner", ind).CornerRadius = UDim.new(1, 0)
	
	btn.Activated:Connect(function()
		active = not active
		ind.BackgroundColor3 = active and Color3.fromRGB(166, 227, 161) or Color3.fromRGB(243, 139, 168)
		onToggle(active)
	end)
end

