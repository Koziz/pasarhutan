--------------------------------------------------------------------------------
-- ENGINE RESTOCK 
--------------------------------------------------------------------------------
task.spawn(function()
	while true do
		task.wait(restockInterval)
		local remote = getRakAksiRemote()
		local function processSlot(slotObj)
			local sName = slotObj.Name
			local item = slotObj:GetAttribute("Item") or slotObj:GetAttribute("ItemId")
			if type(item) == "string" and item ~= "" then slotMemory[sName] = item else item = slotMemory[sName] end
			if item then
				local stock = slotObj:GetAttribute("Stok") or slotObj:GetAttribute("Jumlah") or 0
				if type(stock) == "number" and stock <= restockThreshold then
					restockStatus.Text = "Isi " .. sName .. " (" .. item .. ")"
					pcall(function() remote:InvokeServer("isi", sName, nil) end)
					if stock == 0 then
						task.wait(0.1)
						pcall(function() remote:InvokeServer("taruh", sName, item) end)
					end
					task.wait(0.2)
				end
			end
		end

		if remote then
			if autoRestockAll then
				for _, slotObj in ipairs(getKiosSlots()) do processSlot(slotObj) end
			elseif autoRestockSelected and selectedSlot ~= "" then
				for _, slotObj in ipairs(getKiosSlots()) do
					if slotObj.Name == selectedSlot then processSlot(slotObj) break end
				end
			end
		end
	end
end)

--------------------------------------------------------------------------------
-- ENGINE AUTO LOOT (SMART VISIBILITY DETECTION)
--------------------------------------------------------------------------------
task.spawn(function()
	while true do
		task.wait(lootDelay)
		if autoLoot then
			local spawnBahan = Workspace:FindFirstChild("SpawnBahan")
			local char = LocalPlayer.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")

			if spawnBahan and hrp then
				for _, item in ipairs(spawnBahan:GetChildren()) do
					if not autoLoot then break end 
					
					if selectedLootItem == "Semua" or item.Name:match(selectedLootItem) then
						local prompt = item:FindFirstChildWhichIsA("ProximityPrompt", true)
						
						if prompt and prompt.Parent and prompt.Parent:IsA("BasePart") then
							
							-- FIX: Cek apakah prompt Enable DAN visual itemnya beneran kelihatan di map
							if prompt.Enabled and isItemVisible(item) then
								
								pcall(function() prompt.RequiresLineOfSight = false end)

								local targetCFrame = prompt.Parent.CFrame
								local targetPos = targetCFrame.Position
								lootStatus.Text = "Menuju: " .. item.Name
								
								if selectedMoveMethod == "Teleport (Cepat)" then
									hrp.CFrame = targetCFrame
									hrp.Velocity = Vector3.new(0,0,0) 
									task.wait(0.5) 
									
								elseif selectedMoveMethod == "Tween (Jalan/Terbang)" then
									local dist = (hrp.Position - targetPos).Magnitude
									local duration = dist / tweenSpeed
									local tween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
									tween:Play()
									tween.Completed:Wait()
									hrp.Velocity = Vector3.new(0,0,0)
									task.wait(0.3)
								end
								
								lootStatus.Text = "Mengambil: " .. item.Name
								
								pcall(function()
									prompt:InputHoldBegin()
									task.wait(prompt.HoldDuration + 0.15)
									prompt:InputHoldEnd()
								end)
								
								task.wait(0.5)
							end
						end
					end
				end
				lootStatus.Text = "Status: Menunggu " .. selectedLootItem .. " spawn..."
			end
		end
	end
end)
