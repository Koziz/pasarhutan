			if not UI.emptyNote then
				UI.emptyNote = label(list, "Belum ada bahan di tas", 11, UDim2.fromOffset(4, 4), UDim2.new(1, -8, 0, 16), COL.dim)
			end
		elseif UI.emptyNote then
			UI.emptyNote:Destroy()
			UI.emptyNote = nil
