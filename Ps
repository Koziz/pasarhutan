--[[
	Auto Restock Rak (Kios) - Pasar Hutan
	Mengisi setiap slot rak kios kamu secara otomatis dari bahan di tas.

	Cara kerja (mengikuti mekanik asli game):
	- Pegang bahan di tangan, dekati slot rak (<= 6 stud), lalu tekan E.
	- Ini disimulasikan dengan fireproximityprompt(prompt).
	- Kalau slot sudah PENUH, game tidak menambah apa-apa (aman, tidak rugikan).
	- Slot kosong diisi dengan bahan yang dicentang di UI.

	Butuh executor yang menyediakan fireproximityprompt (Delta, Synapse, dll).
]]

local Players = game:GetService("Players")
local PlayerGui
local player = Players.LocalPlayer
local firePrompt = (getgenv and getgenv().fireproximityprompt) or rawget(_G, "fireproximityprompt")

PlayerGui = player:WaitForChild("PlayerGui", 10)

-- ===================== KONFIGURASI =====================
local CFG = {
	interval    = 10,    -- detik antar siklus
	settle      = 0.35,  -- jeda setelah tiba di slot
	actionWait  = 0.75,  -- jeda setelah menekan prompt
	movePlayer  = true,  -- pindahkan karakter ke slot
	fillEmpty   = true,  -- isi slot kosong
	topUp       = true,  -- top up slot yang sudah berisi
	refreshList = 4,     -- refresh daftar bahan setiap N siklus
	maxLog      = 6,
}

-- preset opsional sebelum skrip dijalankan:
-- getgenv().AutoRestockConfig = { interval = 15, movePlayer = false }
local preset = getgenv().AutoRestockConfig
if type(preset) == "table" then
	for k, v in pairs(preset) do
		if CFG[k] ~= nil then
			CFG[k] = v
		end
	end
end

local UI = nil

-- ===================== STATE =====================
local State = {
	running   = false,
	items     = {},   -- ItemId -> {id, name, count, on}
	order     = {},   -- urutan tampilan
	log       = {},
	cycles    = 0,
	placed    = 0,
	kiosName  = nil,
}

-- ===================== UTILITAS =====================
local function log(msg)
	table.insert(State.log, msg)
	while #State.log > CFG.maxLog do
		table.remove(State.log, 1)
	end
	if UI and UI.refreshLog then
		UI.refreshLog()
	end
end

local function getKios()
	local aktif = workspace:FindFirstChild("KiosAktif")
	if not aktif then
		return nil
	end
	return aktif:FindFirstChild("Kios_" .. player.Name)
end

local function slotList(kios)
	local list = {}
	for _, c in kios:GetChildren() do
		local n = tonumber(string.match(c.Name, "^slot(%d+)$"))
		if n then
			list[#list + 1] = { name = c.Name, index = n, inst = c }
		end
	end
	table.sort(list, function(a, b) return a.index < b.index end)
	return list
end

-- baca kondisi satu slot
local function readSlot(slot)
	local info = {
		prompt = slot:FindFirstChild("RakPrompt"),
		stok   = slot:FindFirstChild("Stok"),
		item   = nil,
		count  = 0,
		action = "",
	}
	if not info.prompt or not info.stok then
		return nil
	end
	for _, v in info.stok:GetChildren() do
		if v:IsA("ValueBase") then
			info.item  = v.Name
			info.count = v.Value or 0
			break
		end
	end
	local rak = slot.StokDisplay and slot.StokDisplay:FindFirstChild("Rak")
	local untuk = rak and rak:GetAttribute("RakUntuk")
	if info.item == nil and type(untuk) == "string" and untuk ~= "SlotKosong" then
		info.item = untuk
	end
	-- sisa 0 atau sudah ditandai SlotKosong = dianggap kosong, supaya bisa diisi
	-- ulang dengan bahan lain
	if info.count <= 0 or untuk == "SlotKosong" then
		info.item = nil
		info.count = 0
	end
	info.action = info.prompt.ActionText or ""
	return info
end

-- cari tumpukan bahan di tas / tangan
local function findStack(id)
	for _, container in ipairs({ player.Backpack, player.Character }) do
		if container then
			for _, it in ipairs(container:GetChildren()) do
				if it:IsA("Tool") and it:GetAttribute("ItemId") == id then
					return it
				end
			end
		end
	end
	return nil
end

local function unequip()
	local char = player.Character
	if char then
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			hum:UnequipTools()
		end
	end
end

local function holdItem(tool)
	local char = player.Character
	if not char or not tool then
		return false
	end
	if tool.Parent ~= char then
		tool.Parent = char
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum:EquipTool(tool)
	end
	return true
end

local function moveTo(pos)
	if not CFG.movePlayer then
		return
	end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hrp and pos then
		hrp.CFrame = CFrame.new(pos + Vector3.new(0, 2, 3))
	end
end

-- ===================== DAFTAR BAHAN =====================
local function scanMaterials()
	local found = {}
	local order = {}
	-- HARUS ikut memindai Character juga: saat bahan dipegang, tool-nya pindah
	-- dari Backpack ke Character, dan kalau tidak dipindai daftar bahan akan
	-- ikut hilang sehingga slot kosong tidak pernah diisi.
	local function tally(container)
		if not container then
			return
		end
		for _, it in ipairs(container:GetChildren()) do
			local id = it:GetAttribute("ItemId")
			if it:IsA("Tool") and id and it:GetAttribute("PusakaItem") ~= true and it:GetAttribute("GaibItem") ~= true then
				if not found[id] then
					-- jangan hilangkan centangan yang sudah diganti user
					local lama = State.items[id]
					found[id] = {
						id = id,
						name = it:GetAttribute("LokSumber") or it.Name,
						count = 0,
						on = lama and lama.on or true,
						skip = lama and lama.skip or false,
					}
					order[#order + 1] = id
					State.items[id] = found[id]
				end
				found[id].count = (found[id].count or 0) + (it:GetAttribute("Count") or 1)
			end
		end
	end
	tally(player.Backpack)
	tally(player.Character)
	State.order = order
	return order
end

local function enabledItems()
	local list = {}
	for _, id in ipairs(State.order) do
		local it = State.items[id]
		if it and it.on then
			list[#list + 1] = id
		end
	end
	return list
end

-- ===================== LOGIKA RESTOCK =====================
-- Pilih bahan untuk slot kosong. Kumar urut: bahan yang belum dipakai slot lain,
-- lalu bahan yang memang tidak bisa dipakai slot lain, lalu bahan yang tadi
-- sudah dicoba dan ditolak rak (biar siklus ini tidak mengulang percobaan sia-sia).
local function pickForEmpty(used, rejected)
	local allowed = enabledItems()
	for _, id in ipairs(allowed) do
		if not used[id] and findStack(id) and not rejected[id] then
			return id
		end
	end
	for _, id in ipairs(allowed) do
		if findStack(id) and not rejected[id] then
			return id
		end
	end
	for _, id in ipairs(allowed) do
		if findStack(id) then
			return id
		end
	end
	return nil
end

-- Aksi pada satu slot. Return: "isi" | "topup" | "penuh" | "gagal" | "lewati"
local function actOnSlot(slot, info, used, rejected)
	local wantId, kind

	if info.item == nil then
		-- slot kosong: pakai bahan pertama yang dicentang dan ada di tas
		if not CFG.fillEmpty then
			return "lewati"
		end
		wantId = pickForEmpty(used, rejected)
		kind = "isi"
		if not wantId then
			return "lewati"
		end
	else
		-- slot sudah berisi: top up dengan bahan yang sama
		if not CFG.topUp then
			return "lewati"
		end
		used[info.item] = true
		wantId, kind = info.item, "topup"
	end

	local stack = findStack(wantId)
	if not stack then
		return "lewati"
	end

	moveTo(slot.WorldPosition)
	task.wait(CFG.settle)
	-- jarumumu bisa bergeser karena physics, ambil ulang posisi
	moveTo(slot.WorldPosition)
	if not holdItem(stack) then
		return "gagal"
	end
	task.wait(0.1)

	if not firePrompt then
		log("fireproximityprompt tidak tersedia")
		return "gagal"
	end

	local before = info.count
	pcall(firePrompt, info.prompt)
	task.wait(CFG.actionWait)

	local after = readSlot(slot)
	if after and after.item ~= nil and after.count > before then
		State.placed += 1
		used[after.item] = true
		log(string.format("%s %s +%d", kind == "isi" and "Isi" or "Top up",
			after.item, after.count - before))
		return kind
	end
	if after and after.item ~= nil and after.count == before then
		return "penuh"
	end
	-- ditolak rak (bahan mentah yang harus diolah dulu, atau sloting penuh)
	rejected[wantId] = true
	return "gagal"
end

local function runCycle()
	local kios = getKios()
	if not kios then
		log("Kios tidak ditemukan")
		return
	end
	State.cycles += 1
	local slots = slotList(kios)
	local used = {}
	local rejected = {}
	local done = { isi = 0, topup = 0, penuh = 0, lewati = 0, gagal = 0 }
	for _, s in ipairs(slots) do
		local info = readSlot(s.inst)
		if info then
			local r = actOnSlot(s.inst, info, used, rejected)
			done[r] = (done[r] or 0) + 1
		end
	end
	unequip()
	State.kiosName = kios.Name
	if UI and UI.refreshStatus then
		UI.refreshStatus(slots)
	end
	local ditolak = {}
	for id in pairs(rejected) do
		ditolak[#ditolak+1] = id
	end
	table.sort(ditolak)
	log(string.format("Siklus #%d - isi %d, top up %d, penuh %d, gagal %d, lewati %d%s",
		State.cycles, done.isi or 0, done.topup or 0, done.penuh or 0, done.gagal or 0, done.lewati or 0,
		#ditolak > 0 and (" (ditolak: " .. table.concat(ditolak, ", ") .. ")") or ""))
end

local function mainLoop()
	while State.running do
		local ok, err = pcall(runCycle)
		if not ok then
			log("Error: " .. tostring(err))
		end
		if State.running then
			for _ = 1, math.floor(CFG.interval * 20) do
				if not State.running then
					break
				end
				task.wait(0.05)
			end
		end
	end
end

local function start()
	if State.running or not firePrompt then
		if not firePrompt then
			log("Executor tidak punya fireproximityprompt")
		end
		return
	end
	State.running = true
	log("Auto restock aktif")
	task.spawn(mainLoop)
end

local function stop()
	State.running = false
	log("Auto restock dihentikan")
	unequip()
end

