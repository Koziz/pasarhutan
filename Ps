	UI.refreshLog = function()
		for _, c in ipairs(logFrame:GetChildren()) do
			c:Destroy()
		end
		for i, msg in ipairs(State.log) do
			local color = COL.dim
			if string.find(msg, "Isi") or string.find(msg, "Top up") then
				color = COL.accent
			elseif string.find(msg, "Error") or string.find(msg, "tidak") then
				color = COL.bad
			elseif string.find(msg, "aktif") then
				color = COL.warn
			end
			label(logFrame, msg, 10, UDim2.fromOffset(2, i * 12), UDim2.new(1, -4, 0, 12), color)
		end
	end

	UI.refreshStatus = function(slots)
		local filled, total, full = 0, 0, 0
		if slots then
			for _, s in ipairs(slots) do
				local info = readSlot(s.inst)
				if info then
					total += 1
					if info.item then
						filled += 1
						if string.find(info.action, "full") or string.find(info.action, "penuh") then
							full += 1
						end
					end
				end
			end
		end
		status.Text = string.format(
			"%s\nSlot terisi %d/%d (penuh %d)  |  siklus %d  |  total masuk %d",
			State.kiosName or "Kios tidak ditemukan", filled, total, full, State.cycles, State.placed)
	end

	-- seret window
	local dragging, dragStart, startPos
	head.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or
			input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = frame.Position
		end
	end)
	frame.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.Movement or
			input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end)
	frame.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or
			input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	minBtn.MouseButton1Click:Connect(function()
		local minimized = not body.Visible
		body.Visible = minimized
		titleLbl.Visible = minimized
		frame.Size = minimized and UDim2.fromOffset(330, 40) or UDim2.fromOffset(330, 460)
		minBtn.Text = minimized and "+" or "-"
	end)
end

